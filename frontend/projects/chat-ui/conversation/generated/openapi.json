          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoundaryError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoundaryError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Read Session",
        "tags": [
          "conversations"
        ]
      }
    },
