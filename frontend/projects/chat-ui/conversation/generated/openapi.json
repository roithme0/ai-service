            "required": true,
            "schema": {
              "description": "Unverified identity: encodeURIComponent(issuer):encodeURIComponent(subject).",
              "pattern": "^(?:[A-Za-z0-9_.!~*'()-]|%[0-9A-Fa-f]{2})+:(?:[A-Za-z0-9_.!~*'()-]|%[0-9A-Fa-f]{2})+$",
              "title": "X-Application-User",
              "type": "string"
            }
          }
        ],
        "responses": {
