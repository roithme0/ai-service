            "type": "array"
          },
          "initial_context": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/FiniteJsonValue-Input"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Context"
          }
