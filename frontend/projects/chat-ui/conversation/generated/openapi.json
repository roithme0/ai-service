{
  "components": {
    "schemas": {
      "ArtifactResponse": {
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "type",
          "created_at",
          "order",
          "turn_id",
          "payload"
        ],
        "title": "ArtifactResponse",
        "type": "object"
      },
      "AssistantMessageResponse": {
        "properties": {
          "role": {
            "const": "assistant",
            "title": "Role",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text",
          "turn_id"
        ],
        "title": "AssistantMessageResponse",
        "type": "object"
      },
      "CompletedTurnResponse": {
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactResponse"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "kind": {
            "const": "completed",
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessageResponse"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "turn_id",
          "message",
          "artifacts"
        ],
        "title": "CompletedTurnResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "unknown_configuration",
              "agent_unavailable",
              "unknown",
              "expired",
              "invalid_message",
              "busy",
              "not_ready",
              "conflict",
              "limit_reached",
              "generation_failed"
            ],
            "title": "Kind",
            "type": "string"
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          }
        },
        "required": [
          "kind"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InputIssue": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "title": "InputIssue",
        "type": "object"
      },
      "InvalidInputResponse": {
        "additionalProperties": false,
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/InputIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "kind": {
            "const": "invalid_input",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "issues"
        ],
        "title": "InvalidInputResponse",
        "type": "object"
      },
      "SessionCreationResponse": {
        "properties": {
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "expires_at"
        ],
        "title": "SessionCreationResponse",
        "type": "object"
      },
      "SessionSnapshotResponse": {
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactResponse"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "messages": {
            "items": {
              "discriminator": {
                "mapping": {
                  "assistant": "#/components/schemas/AssistantMessageResponse",
                  "user": "#/components/schemas/UserMessageResponse"
                },
                "propertyName": "role"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/UserMessageResponse"
                },
                {
                  "$ref": "#/components/schemas/AssistantMessageResponse"
                }
              ]
            },
            "title": "Messages",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "terminal_turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Turn Id"
          },
          "terminal_turn_kind": {
            "anyOf": [
              {
                "enum": [
                  "completed",
                  "generation_failed",
                  "unknown",
                  "expired",
                  "not_ready",
                  "limit_reached",
                  "conflict",
                  "busy"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Turn Kind"
          }
        },
        "required": [
          "session_id",
          "expires_at",
          "messages",
          "artifacts",
          "terminal_turn_id",
          "terminal_turn_kind"
        ],
        "title": "SessionSnapshotResponse",
        "type": "object"
      },
      "UserMessageResponse": {
        "properties": {
          "role": {
            "const": "user",
            "title": "Role",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "null"
          }
        },
        "required": [
          "role",
          "text",
          "turn_id"
        ],
        "title": "UserMessageResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AI Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "hello_world__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Hello World  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Hello World"
      }
    },
