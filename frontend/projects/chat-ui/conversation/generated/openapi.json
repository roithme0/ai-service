            "type": "string"
          }
        },
        "required": [
          "part_kind",
          "artifact"
        ],
        "title": "AcceptedArtifact",
        "type": "object"
      },
      "ArtifactCapability": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "metadataSchema": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/FiniteJsonValue-Input"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadataschema"
          },
          "payloadSchema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FiniteJsonValue-Input"
            },
            "title": "Payloadschema",
            "type": "object"
          },
          "subtitleDescription": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitledescription"
          },
          "titleDescription": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Titledescription"
          },
          "type": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "description",
          "payloadSchema"
        ],
        "title": "ArtifactCapability",
        "type": "object"
      },
      "ArtifactContent": {
        "additionalProperties": false,
