          "type",
          "created_at",
          "run_id",
          "content"
        ],
        "title": "PublishedArtifact",
        "type": "object"
      },
      "RootModel_SessionEvent_": {
        "$ref": "#/components/schemas/SessionEvent",
        "title": "RootModel[SessionEvent]"
      },
      "SessionCreated": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "expires_at"
        ],
        "title": "SessionCreated",
        "type": "object"
      },
      "SessionCreationRequest": {
        "additionalProperties": false,
        "properties": {
          "artifact_capabilities": {
