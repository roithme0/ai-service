            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "BoundaryError",
        "type": "object"
      },
      "FiniteJsonValue-Input": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/FiniteJsonValue-Input"
            },
            "type": "object"
          },
          {
            "items": {
              "$ref": "#/components/schemas/FiniteJsonValue-Input"
            },
            "type": "array"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "FiniteJsonValue-Output": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/FiniteJsonValue-Output"
            },
            "type": "object"
          },
          {
            "items": {
              "$ref": "#/components/schemas/FiniteJsonValue-Output"
            },
            "type": "array"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryItem": {
        "discriminator": {
          "mapping": {
            "turn": "#/components/schemas/PresentedTurn",
            "user-prompt": "#/components/schemas/UserPrompt"
          },
          "propertyName": "part_kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserPrompt"
          },
          {
            "$ref": "#/components/schemas/PresentedTurn"
          }
        ]
      },
      "ObservationErrorEvent": {
        "additionalProperties": false,
