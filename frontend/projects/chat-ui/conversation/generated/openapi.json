          }
        },
        "required": [
          "kind"
        ],
        "title": "TurnAccepted",
        "type": "object"
      },
      "TurnLifecycle": {
        "description": "Application lifecycle only; identity comes from the native run.",
        "properties": {
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
