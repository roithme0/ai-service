  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agents/{configuration}/sessions": {
      "post": {
        "operationId": "create_session_api_v1_agents__configuration__sessions_post",
        "parameters": [
          {
            "in": "path",
            "name": "configuration",
            "required": true,
            "schema": {
              "title": "Configuration",
              "type": "string"
            }
          },
          {
            "description": "Unverified identity: encodeURIComponent(issuer):encodeURIComponent(subject).",
            "in": "header",
            "name": "X-Application-User",
            "required": true,
            "schema": {
              "description": "Unverified identity: encodeURIComponent(issuer):encodeURIComponent(subject).",
              "pattern": "^(?:[A-Za-z0-9_.!~*'()-]|%[0-9A-Fa-f]{2})+:(?:[A-Za-z0-9_.!~*'()-]|%[0-9A-Fa-f]{2})+$",
              "title": "X-Application-User",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoundaryError"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoundaryError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoundaryError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Create Session",
        "tags": [
          "conversations"
        ]
      }
    },
