{
  "name": "ai-service-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:app": "ng serve ai-service-frontend --port 4204",
    "build:app": "ng build ai-service-frontend",
    "watch:app": "ng build ai-service-frontend --watch --configuration development",
    "build:chat-ui": "ng build chat-ui",
    "watch:chat-ui": "ng build chat-ui --watch",
    "pack:chat-ui": "npm run build:chat-ui && npm pack ./dist/chat-ui --pack-destination ./dist",
    "build:image-generation": "ng build image-generation",
    "pack:image-generation": "npm run build:image-generation && npm pack ./dist/image-generation --pack-destination ./dist",
    "check:image-generation-package": "node scripts/check-image-generation-package.mjs",
    "generate:conversation-contract": "node scripts/conversation-contract.mjs",
    "check:conversation-contract": "node scripts/conversation-contract.mjs --check",
    "generate:transcription-contract": "node scripts/transcription-contract.mjs",
    "check:transcription-contract": "node scripts/transcription-contract.mjs --check",
    "generate:image-generation-contract": "node scripts/image-generation-contract.mjs",
    "check:image-generation-contract": "node scripts/image-generation-contract.mjs --check",
    "test:app": "node ../.agents/validation/test.mts --group frontend-app",
    "test:chat-ui": "node ../.agents/validation/test.mts --group chat-ui",
    "test:chat-ui:browser": "node ../.agents/validation/test.mts --group chat-ui-browser",
    "test:image-generation": "node ../.agents/validation/test.mts --group image-generation",
    "test:tooling": "node ../.agents/validation/test.mts --group tooling",
    "format:changed": "node ../.agents/validation/frontend.mts --format",
    "lint": "eslint . ../.agents/validation ../.codex --max-warnings=0",
    "lint:fix": "eslint . ../.agents/validation ../.codex --max-warnings=0 --fix"
  },
  "private": true,
  "packageManager": "npm@10.7.0",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@vitest/browser-playwright": "4.0.8",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "27.0.0",
    "ng-packagr": "^22.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.71.2",
    "vitest": "4.0.8"
  }
}
