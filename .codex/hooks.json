{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:/Code/ai-service/.codex/validate.ps1 -Mode start",
            "timeout": 30,
            "statusMessage": "Recording frontend and backend content before this turn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:/Code/ai-service/.codex/validate.ps1 -Mode stop",
            "timeout": 1500,
            "statusMessage": "Formatting changed files and validating affected frontend and backend code"
          }
        ]
      }
    ]
  }
}
