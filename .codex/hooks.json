{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Code/ai-service/.codex/validate.mts --start",
            "timeout": 30,
            "statusMessage": "Recording frontend and backend content before this turn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Code/ai-service/.codex/validate.mts --stop",
            "timeout": 2400,
            "statusMessage": "Validating changed code and running Playwright against an updated Docker stack"
          }
        ]
      }
    ]
  }
}
