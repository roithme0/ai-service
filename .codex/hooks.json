{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:/Code/ai-service/.codex/validate-frontend.ps1 -Mode start",
            "timeout": 30,
            "statusMessage": "Recording frontend content before this turn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:/Code/ai-service/.codex/validate-frontend.ps1 -Mode stop",
            "timeout": 900,
            "statusMessage": "Formatting changed frontend files, checking lint and running all frontend tests"
          }
        ]
      }
    ]
  }
}
