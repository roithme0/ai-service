{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "NodeNext",
    "types": ["node"],
    "typeRoots": ["../../frontend/node_modules/@types"],
    "paths": {
      "prettier": ["../../frontend/node_modules/prettier/index.d.ts"],
      "eslint": ["../../frontend/node_modules/eslint/lib/types/index.d.ts"]
    }
  },
  "include": ["**/*.mts"]
}
